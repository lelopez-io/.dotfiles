# zsh-no-matches-found
unsetopt nomatch

# inline # comments in interactive shells
setopt interactive_comments

# emacs keybindings (EDITOR=nvim triggers vi mode, restore emacs line editing)
bindkey -e
# line navigation (previously provided by oh-my-zsh)
bindkey "^A"    beginning-of-line                # Cmd+Left
bindkey "^E"    end-of-line                      # Cmd+Right
bindkey "^[b"   backward-word                    # Option+Left
bindkey "^[f"   forward-word                     # Option+Right
bindkey "^[[A"  history-beginning-search-backward # Up (prefix search)
bindkey "^[[B"  history-beginning-search-forward  # Down (prefix search)

# mise - interactive shell support
eval "$(mise activate zsh)"
# Omarchy 4.5 puts mise's command wrappers first, which hides the claude and
# pi wrappers in ~/.local/bin. mise's prompt hook rebuilds PATH, so this runs
# after it at every prompt.
_local_bin_first() { path=("$HOME/.local/bin" ${path:#$HOME/.local/bin}) }
precmd_functions+=(_local_bin_first)
_local_bin_first

# tmux/venv
[ -n "$VIRTUAL_ENV" ] && \. "$VIRTUAL_ENV/bin/activate"

# kubectl - load completions and bind k alias
if (( $+commands[kubectl] )); then
  local _kubectl_comp="${HOME}/.zsh/completions/_kubectl"
  if [[ ! -f "$_kubectl_comp" || "$_kubectl_comp" -ot "$(command -v kubectl)" ]]; then
    mkdir -p "${_kubectl_comp:h}" && kubectl completion zsh > "$_kubectl_comp"
  fi
  compdef k=kubectl
fi

# gco - disable file completion, arg is an fzf query
compdef _nothing gco

# recover orphaned mouse-tracking mode. SSH into a `mouse on` tmux enables
# mouse reporting on THIS terminal; an abrupt drop (laptop closed -> broken
# pipe) never sends the disable, leaving the terminal spewing SGR mouse codes
# (\e[<b;x;yM). turn all mouse-report modes off on every prompt so a dead
# session can't leave the terminal stuck.
_disable_mouse_reporting() { print -n '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l' }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _disable_mouse_reporting

