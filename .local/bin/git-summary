#!/usr/bin/env bash
#
# git-summary — log + diff of everything since a base ref (default: main or master).
#
# Usage: git-summary [-p|--print] [base-ref]
#
# Also runnable as `git summary` — git treats git-* executables on PATH as
# subcommands.

set -euo pipefail

usage() {
    cat <<'EOF'
git-summary — log + diff of everything since a base ref (default: main or master).

Usage: git-summary [-p|--print] [base-ref]

  -p, --print   Print to the terminal instead of writing files.
  [base-ref]    Commit/branch to compare from (default: main, else master).

Without -p, writes git-log.txt and git-diff.txt in the current directory.
Also works as `git summary` — git treats git-* on PATH as subcommands.
EOF
}

print_mode=false
base_ref=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -p|--print) print_mode=true; shift ;;
        -*)
            echo "git-summary: unknown option: $1" >&2
            usage >&2
            exit 2 ;;
        *)
            if [[ -z "$base_ref" ]]; then
                base_ref=$1
                shift
            else
                echo "git-summary: unexpected argument: $1" >&2
                usage >&2
                exit 2
            fi ;;
    esac
done

if [[ -z "$base_ref" ]]; then
    if git show-ref --quiet refs/heads/main; then
        base_ref=main
    elif git show-ref --quiet refs/heads/master; then
        base_ref=master
    else
        echo "git-summary: neither 'main' nor 'master' branch found." >&2
        exit 1
    fi
elif ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
    echo "git-summary: invalid ref: $base_ref" >&2
    exit 1
fi

# %ad = author date · %h = short hash · %s = subject · %b = body
log_format="%ad [%h] %s%n%n%b%n----------------------------------------"

if $print_mode; then
    echo "=== Git Log Summary (${base_ref}..HEAD) ==="
    git -P log --date=format:"%Y-%m-%d %H:%M:%S" --pretty=format:"$log_format" "${base_ref}..HEAD"
    printf '\n\n=== Git Diff Summary (%s..HEAD) ===\n' "$base_ref"
    git -P diff -U0 "${base_ref}..HEAD"
    printf '\nGit summary completed (printed to terminal)\n'
else
    git -P log --date=format:"%Y-%m-%d %H:%M:%S" --pretty=format:"$log_format" "${base_ref}..HEAD" > git-log.txt
    echo "Generated git-log.txt with timestamps and full commit messages"
    git -P diff -U0 "${base_ref}..HEAD" > git-diff.txt
    echo "Generated git-diff.txt"
    echo "Git summary completed. Files created: git-log.txt and git-diff.txt"
fi
