#!/bin/bash
# claude — run through cld only when this directory resolves a profile
# (agent-profile). Everything else execs the real binary bare: personal
# OAuth needs no key.
# Resolve the real claude: brew path first, then the native installer's
# newest version dir (mtime). PATH lookup would recurse back into this shim.
real_claude() {
  if [ -x /opt/homebrew/bin/claude ]; then
    echo /opt/homebrew/bin/claude
    return 0
  fi
  local latest
  # shellcheck disable=SC2012 # ls -dt is the mtime-ordered answer here; find+stat is worse.
  latest=$(ls -dt "$HOME"/.local/share/claude/versions/* 2>/dev/null | head -1)
  [ -n "$latest" ] && [ -x "$latest" ] && echo "$latest"
}

# Launch bare, recording that the session is keyless on purpose so a resume
# from a profile-carrying directory doesn't attach a work key unnoticed.
bare() {
  export AGENT_WRAPPER=claude AGENT_PROFILE=none
  # -a: herdr names a pane's agent from argv[0], and the native
  # installer's binary is called for its version (2.1.260), not claude.
  exec -a claude "$(real_claude)" "$@"
}

# A resumed session keeps the profile it started under (agent-session-mark).
# The resuming shell's cwd may belong to another org, or to none. Only an
# explicit --resume id consults the record. -c and the picker stay on cwd.
session_id=""
prev=""
for arg in "$@"; do
  case $arg in
    --resume=*) session_id=${arg#--resume=}; break ;;
  esac
  case $prev in
    --resume|-r) session_id=$arg; break ;;
  esac
  prev=$arg
done

profile=""
[ -n "$session_id" ] && profile=$(agent-session-profile "$session_id" 2>/dev/null)
[ "$profile" = none ] && bare "$@"

[ -n "$profile" ] || profile=$(agent-profile claude || true)
[ -n "$profile" ] && exec cld "$profile" "$@"
bare "$@"
