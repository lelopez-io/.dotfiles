#!/usr/bin/env bash
#
# claude / cld — launch Claude Code, optionally with an API key profile from
# 1Password.
#
# Usage: claude [claude args...]         profile resolved from session or cwd
#        cld [profile] [claude args...]  profile named explicitly
#
# Profile resolves to a 1Password item named "cld | <profile>" with two fields:
#   credential   the API key or OAuth token
#   env_var      ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN
# Without a profile, launches claude with the default config.

set -euo pipefail

usage() {
    cat <<'USAGE'
claude / cld — launch Claude Code with an optional API key profile via 1Password.

Usage: claude [claude args...]         profile resolved from session or cwd
       cld [profile] [claude args...]  profile named explicitly

Profile resolves to a 1Password item named "cld | <profile>" with two fields:
  credential   the API key or OAuth token
  env_var      ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN

Without a profile, launches claude with the default config.
Flags (e.g. --resume) without a profile are passed through.
USAGE
}

# herdr resumes a pane by running `claude`, so this file owns that name and
# reaches the real binary by path: brew first, then the native installer's
# newest version dir (mtime). A PATH lookup would recurse back into here.
real_claude() {
  if [ -x /opt/homebrew/bin/claude ]; then
    echo /opt/homebrew/bin/claude
    return 0
  fi
  local latest
  # shellcheck disable=SC2012 # ls -dt is the mtime-ordered answer here; find+stat is worse.
  latest=$(ls -dt "$HOME"/.local/share/claude/versions/* 2>/dev/null | head -1)
  [ -n "$latest" ] && [ -x "$latest" ] && echo "$latest"
}

# Outside ~/.claude because Claude Code rewrites anything it finds there.
# --settings merges additively: it adds to the live file, never replaces it.
shared_settings() {
  local f="$HOME/.config/claude/shared-settings.json"
  [ -f "$f" ] || return 0
  case " $* " in *" --settings "*|*" --settings="*) return 0 ;; esac
  printf '%s' "$f"
}

wrapper=${0##*/}
profile=""

if [ "$wrapper" = cld ]; then
    profile=${1:-}
    case "$profile" in
        -h|--help) usage; exit 0 ;;
        -*) profile="" ;;    # flag for claude, not a profile — pass through
        ?*) shift ;;         # profile name consumed
    esac
else
    # A resumed session keeps the profile it started under (agent-session-mark).
    # The resuming shell's cwd may belong to another org, or to none. Only an
    # explicit --resume id consults the record. -c and the picker stay on cwd.
    session_id=""
    prev=""
    for arg in "$@"; do
        case $arg in
            --resume=*) session_id=${arg#--resume=}; break ;;
        esac
        case $prev in
            --resume|-r) session_id=$arg; break ;;
        esac
        prev=$arg
    done

    [ -n "$session_id" ] && profile=$(agent-session-profile "$session_id" 2>/dev/null || true)
    if [ "$profile" = none ]; then
        profile=""    # recorded keyless: the cwd does not get to override it
    elif [ -z "$profile" ]; then
        profile=$(agent-profile claude || true)
    fi
fi

if [ -n "$profile" ]; then
    op_item="cld | $profile"
    key=$(op item get "$op_item" --fields credential --reveal) \
        || { echo "$wrapper: failed to read credential from 1Password item '$op_item'" >&2; exit 1; }
    key_var=$(op item get "$op_item" --fields env_var --reveal) \
        || { echo "$wrapper: failed to read env_var from 1Password item '$op_item'" >&2; exit 1; }

    echo "Starting Claude Code [$profile]" >&2  # status, not data: stdout is the agent's
    export "$key_var=$key"
fi

# Published for agent-session-mark: the session_start hook stamps this
# context onto the session id, so a later resume replays it instead of
# re-deriving a profile from wherever the resuming shell happens to be.
export AGENT_WRAPPER="$wrapper" AGENT_PROFILE="${profile:-none}"

# Strip OP_SESSION_* so the agent can't ride this shell's op session into the
# whole vault (backstop for "don't opsignin in agent-launching shells").
for v in $(env | sed -n 's/^\(OP_SESSION_[^=]*\)=.*/\1/p'); do unset "$v"; done

# exec replaces this script: claude's exit status propagates, and the exported
# key lives only in claude's own process environment. -a keeps argv[0]
# "claude" so herdr still names the agent; the binary carries a version.
shared=$(shared_settings "$@")
if [ -n "$shared" ]; then
  exec -a claude "$(real_claude)" --settings "$shared" "$@"
fi
exec -a claude "$(real_claude)" "$@"
