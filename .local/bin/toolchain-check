#!/usr/bin/env bash
#
# toolchain-check — report whether zig 0.15.2 can link against the SDK this
# machine hands it, and name an installed SDK that it can.
#
# Usage: toolchain-check [-q | --usable-sdk]
#
#   -q             print only problems, no report
#   --usable-sdk   print an SDK that links, nothing else
#
# Exit: 0 usable, 1 unusable, 2 undetermined.
#
# zig matches the link target exactly against the libSystem stub's first
# document, where the macOS 26 SDK declares only arm64e (ziglang/zig#31658).
# Re-exports below it declare arm64-macos, so a whole-file grep is fooled.
#
# zig picks its SDK by running `xcrun --show-sdk-path`, which answers with the
# newest installed one; neither SDKROOT nor the MacOSX.sdk symlink moves it.

set -euo pipefail

mode=report
case "${1:-}" in
    -q|--quiet) mode=quiet ;;
    --usable-sdk) mode=sdkpath ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "") ;;
    *) echo "toolchain-check: unknown option '$1'" >&2; exit 2 ;;
esac

say() { [ "$mode" = report ] && echo "$@"; return 0; }
warn() { [ "$mode" = sdkpath ] || echo "$@" >&2; return 0; }

[ "$(uname -s)" = Darwin ] || { say "not macOS, nothing to check"; exit 0; }

# The first document ends at the second '--- !tapi-tbd'; its targets list wraps.
umbrella_targets() {
    awk '
        /^--- !tapi-tbd/ { if (++doc > 1) exit }
        /^targets:/      { in_t = 1 }
        in_t             { print; if (/\]/) exit }
    ' "$1"
}

# Bounded so arm64e-macos cannot match.
declares_arm64() {
    umbrella_targets "$1" |
        grep -Eq '(^|[[:space:],[])arm64-macos([[:space:],]|\]|$)'
}

links() {
    [ -f "$1/usr/lib/libSystem.tbd" ] && declares_arm64 "$1/usr/lib/libSystem.tbd"
}

canon() { readlink -f "$1" 2>/dev/null || echo "$1"; }

# A MacOSX.sdk aimed away from the SDK xcrun reports does nothing for zig and
# only moves what every other compiler defaults to. Report it so it can go back.
inert_repoint() {
    local link; link="$(dirname "$1")/MacOSX.sdk"
    [ -L "$link" ] || return 1
    [ "$(canon "$link")" != "$(canon "$1")" ] || return 1
    links "$link" || return 1
    echo "$link"
}

selected=$(xcode-select -p 2>/dev/null || true)
active=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)

# Command Line Tools keep SDKs at the top; Xcode keeps them under the platform.
installed_sdks() {
    local dd
    for dd in "$selected" /Library/Developer/CommandLineTools \
              /Applications/Xcode*.app/Contents/Developer; do
        [ -d "$dd" ] || continue
        /bin/ls -d "$dd"/SDKs/MacOSX*.sdk \
            "$dd"/Platforms/MacOSX.platform/Developer/SDKs/MacOSX*.sdk 2>/dev/null || true
    done
}

usable_sdk() {
    local s
    while read -r s; do
        [ -n "$s" ] || continue
        if links "$s"; then echo "$s"; return 0; fi
    done < <(installed_sdks)
    return 1
}

if [ "$mode" = sdkpath ]; then
    usable_sdk || exit 1
    exit 0
fi

say "selected:  ${selected:-<none>}"
say "sdk:       ${active:-<none>}"

if [ -z "$active" ]; then
    warn "toolchain-check: xcrun reported no SDK, cannot verify."
    exit 2
fi

if links "$active"; then
    say "stub:      declares arm64-macos, zig 0.15.2 can link against it"
    say ""
    say "This checks the SDK links, not that any particular build succeeds."
    exit 0
fi

warn "toolchain-check: the SDK xcrun hands zig is arm64e-only, so"
warn "  zig 0.15.2 cannot link against it (ziglang/zig#31658)."
if sdk=$(usable_sdk); then
    warn "  This one links: $sdk"
    warn "  The fork builds shim xcrun at it; no machine change is needed."
    if repoint=$(inert_repoint "$active"); then
        warn "  $(basename "$repoint") points at $(basename "$(readlink "$repoint")"),"
        warn "  which xcrun ignores. Put it back with:"
        warn "    sudo ln -sfn $(basename "$active") $repoint"
    fi
    exit 1
fi
warn "  No installed SDK declares arm64-macos. Reinstalling Command Line"
warn "  Tools brings the previous major macOS SDK, which does; failing that,"
warn "  developer.apple.com/download/all has the standalone packages."
exit 1
