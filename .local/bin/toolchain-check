#!/usr/bin/env bash
#
# toolchain-check — report whether the selected macOS developer toolchain can
# build what this repo builds from source.
#
# Usage: toolchain-check [-q]
#
#   -q   print only problems, no report
#
# Exit: 0 usable, 1 unusable, 2 undetermined.
#
# zig 0.15.2 matches the link target exactly against the libSystem stub's first
# document, where the macOS 26 SDK declares only arm64e (ziglang/zig#31658).
# Re-exports below it declare arm64-macos, so a whole-file grep is fooled.

set -euo pipefail

quiet=false
case "${1:-}" in
    -q|--quiet) quiet=true ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "") ;;
    *) echo "toolchain-check: unknown option '$1'" >&2; exit 2 ;;
esac

say() { $quiet || echo "$@"; }
warn() { echo "$@" >&2; }

[ "$(uname -s)" = Darwin ] || { say "not macOS, nothing to check"; exit 0; }

# The first document ends at the second '--- !tapi-tbd'; its targets list wraps.
umbrella_targets() {
    awk '
        /^--- !tapi-tbd/ { if (++doc > 1) exit }
        /^targets:/      { in_t = 1 }
        in_t             { print; if (/\]/) exit }
    ' "$1"
}

# Bounded so arm64e-macos cannot match.
declares_arm64() {
    umbrella_targets "$1" |
        grep -Eq '(^|[[:space:],[])arm64-macos([[:space:],]|\]|$)'
}

selected=$(xcode-select -p 2>/dev/null || true)
sdk=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)
tbd="$sdk/usr/lib/libSystem.tbd"

say "selected:  ${selected:-<none>}"
say "sdk:       ${sdk:-<none>}"

if [ -z "$sdk" ] || [ ! -f "$tbd" ]; then
    warn "toolchain-check: no libSystem.tbd under '${sdk:-<no sdk>}', cannot verify."
    exit 2
fi

if declares_arm64 "$tbd"; then
    say "stub:      declares arm64-macos, zig 0.15.2 can link against it"
    say ""
    say "This checks the SDK links, not that any particular build succeeds."
    exit 0
fi

warn "toolchain-check: the active SDK's libSystem stub is arm64e-only."
warn "  zig 0.15.2 cannot link against it; builds fail on undefined symbols."
warn "  Any SDK declaring arm64-macos works, and Command Line Tools ship one,"
warn "  so try 'softwareupdate --list' for a CLT update before reaching for Xcode."
exit 1
