#!/usr/bin/env python3
"""serie-follow -- serie in a transparent pty with an input-quiet hook.

Runs `serie -p kitty` (extra args appended), forwarding bytes both ways
unchanged. Each stdin byte arms a debounce; once input goes quiet (the
closest a terminal gets to key-up without the kitty keyboard protocol)
it reads the selected commit off the rendered pane and re-points the
hunk pane via `hunk session reload`. Idle costs nothing.

serie has no selection API, so the selected row is read from the pane:
the themed background row ending in "<hash>  <date>". Spawned by
git-graph; standalone it is serie with a side effect.
"""
import fcntl
import json
import os
import pty
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import threading
import time
import tty

# Above the 90ms macOS key-repeat interval so holding j/k never fires
# mid-hold; small next to the ~345ms hunk reload that dominates.
DEBOUNCE_S = float(os.environ.get("SERIE_FOLLOW_DEBOUNCE_MS", "120")) / 1000
SGR = re.compile(rb"\x1b\[[0-9;]*m")
ROW = re.compile(r"([0-9a-f]{7,40})\s+\d{4}-\d{2}-\d{2}")


def log(msg):
    path = os.environ.get("SERIE_FOLLOW_LOG")
    if path:
        with open(path, "a") as f:
            f.write(f"{time.time():.2f} {msg}\n")


def selected_hash(pane_id):
    out = subprocess.run(
        ["herdr", "pane", "read", pane_id, "--source", "visible",
         "--format", "ansi"],
        capture_output=True, timeout=5).stdout
    for line in out.splitlines():
        if b"\x1b[48;" not in line:  # background SGR = the selected row
            continue
        found = ROW.findall(SGR.sub(b"", line).decode("utf-8", "replace"))
        if found:
            return found[-1]
    return None


class Follower:
    """Latest-wins sync: fire() marks work; one worker drains it.

    A settle landing mid-reload cannot be dropped or the pane goes stale,
    so the worker re-reads the selection after every reload and goes
    again until the pane matches the cursor.
    """

    def __init__(self):
        self.pane_id = os.environ.get("HERDR_PANE_ID")
        # Seed with the WIP sentinel: git-graph opens hunk on the
        # worktree, and serie boots on the WIP row, so the first settle
        # there must not reload.
        self.last = "0" * 40
        # Matching the exported pane's foreground pid to a session pins
        # the reload target; a second hunk on the repo would make
        # --repo . ambiguous. Standalone falls back to --repo ..
        self.hunk_pane = os.environ.get("SERIE_FOLLOW_HUNK_PANE")
        self.session = None
        self.lock = threading.Lock()
        self.running = False
        self.poked = False

    def _target(self):
        if not self.hunk_pane:
            return ["--repo", "."]
        if self.session is None:
            info = subprocess.run(
                ["herdr", "pane", "process-info", "--pane", self.hunk_pane],
                capture_output=True, timeout=5)
            pids = {p["pid"] for p in json.loads(info.stdout)["result"]
                    ["process_info"]["foreground_processes"]}
            listing = subprocess.run(["hunk", "session", "list", "--json"],
                                     capture_output=True, timeout=5)
            for sess in json.loads(listing.stdout)["sessions"]:
                if sess["pid"] in pids:
                    self.session = sess["sessionId"]
                    log(f"pinned session {self.session[:8]}")
                    break
        return [self.session] if self.session else ["--repo", "."]

    def fire(self):
        if not self.pane_id:
            return
        with self.lock:
            self.poked = True
            if self.running:
                return  # the worker re-checks before exiting
            self.running = True
        threading.Thread(target=self._drain, daemon=True).start()

    def _drain(self):
        while True:
            with self.lock:
                self.poked = False
            try:
                h = selected_hash(self.pane_id)
                if h and not (self.last
                              and (self.last.startswith(h)
                                   or h.startswith(self.last))):
                    # The WIP row's zero-hash sentinel means the worktree.
                    view = ["diff"] if set(h) == {"0"} else ["show", h]
                    r = subprocess.run(
                        ["hunk", "session", "reload", *self._target(),
                         "--", *view],
                        capture_output=True, timeout=15)
                    if r.returncode == 0:
                        self.last = h
                        log(f"reloaded {h}")
                        continue  # cursor may have moved meanwhile
                    self.session = None  # stale pin: re-resolve next round
                    log(f"reload failed {h}: {r.stderr.decode().strip()}")
            except Exception as e:  # never take serie down over a sync miss
                log(f"error {e}")
            with self.lock:
                if not self.poked:
                    self.running = False
                    return


def main():
    args = ["serie", "-p", "kitty", *sys.argv[1:]]
    pid, master = pty.fork()
    if pid == 0:
        os.execvp(args[0], args)

    def winsize():
        try:
            ws = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    winsize()
    signal.signal(signal.SIGWINCH, lambda *_: winsize())

    follower = Follower()
    # Pre-resolve the pin so the first settle pays only the reload; a
    # race with the first fire resolves the same id twice, harmlessly.
    if follower.hunk_pane:
        threading.Thread(target=follower._target, daemon=True).start()
    saved = None
    try:
        saved = termios.tcgetattr(0)
        tty.setraw(0)
    except termios.error:
        pass  # no tty on stdin: still forward, just never raw

    quiet_at = None
    try:
        while True:
            try:
                r, _, _ = select.select([0, master], [], [], 0.05)
            except InterruptedError:
                continue
            if 0 in r:
                data = os.read(0, 4096)
                if not data:
                    break
                os.write(master, data)
                quiet_at = time.monotonic() + DEBOUNCE_S
            if master in r:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    break  # serie exited
                if not data:
                    break
                os.write(1, data)
            if quiet_at is not None and time.monotonic() >= quiet_at:
                quiet_at = None
                threading.Thread(target=follower.fire, daemon=True).start()
    finally:
        if saved is not None:
            termios.tcsetattr(0, termios.TCSADRAIN, saved)
        _, status = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status))


if __name__ == "__main__":
    main()
