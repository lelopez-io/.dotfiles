#!/bin/bash
# pi — route every invocation through pie so non-interactive launchers
# (herdr runs bare `pi --session ...`) authenticate like interactive ones.
# The profile is per-machine (agent-profile), unset here so no identity
# lives in the repo.

# A resume names its session, and that id outranks the cwd: it may have
# started under another org, or none (agent-session-mark). Fresh starts,
# pickers, and partial ids name no exact session, so cwd decides for them.
session_id=""
prev=""
for arg in "$@"; do
  case $prev in
    --session-id) session_id=$arg; break ;;
    --session)
      # The id is the trailing _<uuid> of the session filename. The marker
      # extension derives it the same way, and the two must stay in sync.
      f=${arg##*/}; f=${f%.jsonl}; session_id=${f##*_}
      break
      ;;
  esac
  prev=$arg
done

profile=""
[ -n "$session_id" ] && profile=$(agent-session-profile "$session_id" 2>/dev/null)

# none is a recorded answer, not a missing one: stay keyless.
[ "$profile" = none ] && exec pie "$@"

[ -n "$profile" ] || profile=$(agent-profile pi || true)
[ -n "$profile" ] || {
  echo "pi: no profile resolved. Set 'git config agent.pi.profile <name>' or" >&2
  echo "    create ~/.config/agent-profiles/pi (machine-local, uncommitted)" >&2
  exit 1
}
exec pie "$profile" "$@"
