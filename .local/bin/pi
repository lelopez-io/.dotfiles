#!/bin/bash
# pi — route every invocation through the 1Password profile wrapper so
# non-interactive launchers (herdr agent resume runs bare `pi --session ...`)
# authenticate the same way interactive ones do. Profile resolves per
# directory via agent-profile (git config agent.pi.profile > org includeIf >
# ~/.config/agent-profiles/pi &&. Shim wins PATH via .zprofile's
# last-prepend; pie execs the real binary by absolute path.
profile=$(agent-profile pi || true)
exec pie "${AGENT_PROFILE}" "$@"
