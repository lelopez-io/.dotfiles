#!/bin/bash
# herdr-fork-update — build and install the patched herdr from the fork.
#
# Why: we run a local fork of herdr (feature branches merged into a
# reconstructed build branch). Upstream now renders kitty graphics itself;
# the fork adds HERDR_IMAGE_PROTOCOL so pane apps can tell, and a mise
# toolchain pin. This keeps any machine current:
# clones on first run, fetches+fast-forwards after, builds release, installs
# to ~/.local/bin/herdr (which shadows the brew binary via PATH order).
#
# Works locally and on SSH remotes. Builds with the mise-managed rust and
# zig the fork's own mise.toml pins, so a toolchain bump upstream needs no
# edit here; `mise install` inside the checkout fetches them.
set -euo pipefail

REPO="${HERDR_FORK_REPO:-$HOME/xo/lelopez-io/herdr}"
BRANCH="${HERDR_FORK_BRANCH:-build}"
REMOTE_URL="${HERDR_FORK_URL:-https://github.com/lelopez-io/herdr.git}"

# Resolve through stow's symlink: the build cds away, and a sibling script may
# not be restowed into ~/.local/bin yet.
here=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)

if [ ! -d "$REPO/.git" ]; then
  echo "herdr-fork-update: cloning $REMOTE_URL into $REPO"
  mkdir -p "$(dirname "$REPO")"
  git clone --branch "$BRANCH" "$REMOTE_URL" "$REPO"
fi

cd "$REPO"
git fetch origin "$BRANCH"
# Reset rather than merge: the build branch is reconstructed from upstream
# plus the feature branches and force-pushed per sync, so a build checkout
# follows it exactly.
# (No local edits belong here — keep them upstream of this script.)
git checkout -B "$BRANCH" -q "origin/$BRANCH"
git reset --hard -q "origin/$BRANCH"

# zig picks its SDK by running `xcrun` from PATH and nothing else, so a shim
# there aims it at an SDK that links, leaving the machine alone.
# Status 1 is a definite no; 2 means undetermined, so let the build try.
rc=0
"$here/toolchain-check" -q || rc=$?
if [ "$rc" -eq 1 ]; then
  if sdk=$("$here/toolchain-check" --usable-sdk 2>/dev/null); then
    shim=$(mktemp -d)
    trap 'rm -rf "$shim"' EXIT
    cat > "$shim/xcrun" <<SHIM
#!/bin/bash
for a in "\$@"; do
  if [ "\$a" = --show-sdk-path ]; then echo "$sdk"; exit 0; fi
done
exec /usr/bin/xcrun "\$@"
SHIM
    chmod 755 "$shim/xcrun"
    export PATH="$shim:$PATH"
    echo "herdr-fork-update: the SDK xcrun hands zig cannot link; building"
    echo "  against $sdk"
  else
    echo "herdr-fork-update: aborting, no installed SDK can link zig." >&2
    exit 1
  fi
fi

mise install
echo "herdr-fork-update: building release ($(mise x -- zig version | sed 's/^/zig /'), $(mise x -- rustc --version | cut -d' ' -f1-2))..."
mise x -- cargo build --release

mkdir -p "$HOME/.local/bin"
install -m 755 target/release/herdr "$HOME/.local/bin/herdr"
echo "herdr-fork-update: installed $("$HOME/.local/bin/herdr" --version) to ~/.local/bin/herdr"

# install(1) swaps the binary under running servers. A PROTOCOL_VERSION
# bump then blocks `herdr --remote` even when both versions print the
# same. Warn only: stopping the server that owns this shell kills the caller.
if command -v jq &> /dev/null; then
  stale=$(
    "$HOME/.local/bin/herdr" session list --json 2>/dev/null \
      | jq -r '.sessions[] | select(.running) | "\(.name)\t\(.socket_path)"' \
      | while IFS=$'\t' read -r name sock; do
          compat=$(HERDR_SOCKET_PATH="$sock" "$HOME/.local/bin/herdr" \
            status server --json 2>/dev/null | jq -r '.compatible')
          if [ "$compat" = "false" ]; then printf '  %s\n' "$name"; fi
        done
  ) || true
  if [ -n "$stale" ]; then
    echo "herdr-fork-update: these servers still run the previous build:"
    echo "$stale"
    echo '  local panes keep working; `herdr --remote` will refuse to attach.'
    echo "  clear each with: herdr --session <name> server stop"
  fi
fi
