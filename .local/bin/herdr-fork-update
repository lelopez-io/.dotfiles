#!/bin/bash
# herdr-fork-update — build and install the patched herdr from the fork.
#
# Why: we run a local fork of herdr (feature branches merged into a
# reconstructed build branch) until upstream lands the graphics fix
# (discussion herdrdev/herdr#2863). This keeps any machine current:
# clones on first run, fetches+fast-forwards after, builds release, installs
# to ~/.local/bin/herdr (which shadows the brew binary via PATH order).
#
# Works locally and on SSH remotes. Needs mise-managed rust + zig:
#   mise install rust@1.96.1 zig@0.15.2
# (zig 0.15.2 exactly: the vendored libghostty-vt build breaks on 0.16.)
set -euo pipefail

REPO="${HERDR_FORK_REPO:-$HOME/xo/lelopez-io/herdr}"
BRANCH="${HERDR_FORK_BRANCH:-build}"
REMOTE_URL="${HERDR_FORK_URL:-https://github.com/lelopez-io/herdr.git}"

if [ ! -d "$REPO/.git" ]; then
  echo "herdr-fork-update: cloning $REMOTE_URL into $REPO"
  mkdir -p "$(dirname "$REPO")"
  git clone --branch "$BRANCH" "$REMOTE_URL" "$REPO"
fi

cd "$REPO"
git fetch origin "$BRANCH"
# Reset rather than merge: the build branch is reconstructed from upstream
# plus the feature branches and force-pushed per sync, so a build checkout
# follows it exactly.
# (No local edits belong here — keep them upstream of this script.)
git checkout -B "$BRANCH" -q "origin/$BRANCH"
git reset --hard -q "origin/$BRANCH"

# Preflight: zig 0.15.2 targets plain arm64-macos and some SDK stubs are
# arm64e-only, which fails linking with pages of "undefined symbol". Which
# SDKs carry the stub varies by install, so check rather than assume.
if [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
  # Installing Xcode does not select it, and CLT ships a different SDK. Name
  # the one-line fix here rather than leaving it to a wall of link errors.
  if [ -d /Applications/Xcode.app ] &&
     [ "$(xcode-select -p 2>/dev/null)" = /Library/Developer/CommandLineTools ]; then
    echo "herdr-fork-update: WARNING: Xcode is installed but Command Line Tools" >&2
    echo "  are selected. If the zig build fails below, switch and retry:" >&2
    echo "  sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
  fi

  sdk=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)
  tbd="$sdk/usr/lib/libSystem.tbd"
  if [ ! -f "$tbd" ]; then
    echo "herdr-fork-update: WARNING: no libSystem.tbd under '${sdk:-<no sdk path>}'," >&2
    echo "  so the arm64-macos stub check was skipped. If the zig build now fails" >&2
    echo "  with undefined symbols, the active SDK is the cause." >&2
  elif ! grep -q "arm64-macos" "$tbd"; then
    echo "herdr-fork-update: ERROR: active SDK ($sdk) has no arm64-macos stub" >&2
    echo "  zig 0.15.2 cannot link against an arm64e-only libSystem.tbd." >&2
    echo "  Quarantine it so xcrun returns an older SDK, e.g.:" >&2
    echo "  sudo mkdir -p /tmp/sdk-quarantine && sudo mv \"$sdk\" /tmp/sdk-quarantine/" >&2
    exit 1
  fi
fi

echo "herdr-fork-update: building release (rust 1.96.1, zig 0.15.2)..."
mise x rust@1.96.1 zig@0.15.2 -- cargo build --release

mkdir -p "$HOME/.local/bin"
install -m 755 target/release/herdr "$HOME/.local/bin/herdr"
echo "herdr-fork-update: installed $("$HOME/.local/bin/herdr" --version) to ~/.local/bin/herdr"

# install(1) swaps the binary under running servers. A PROTOCOL_VERSION
# bump then blocks `herdr --remote` even when both versions print the
# same. Warn only: stopping the server that owns this shell kills the caller.
if command -v jq &> /dev/null; then
  stale=$(
    "$HOME/.local/bin/herdr" session list --json 2>/dev/null \
      | jq -r '.sessions[] | select(.running) | "\(.name)\t\(.socket_path)"' \
      | while IFS=$'\t' read -r name sock; do
          compat=$(HERDR_SOCKET_PATH="$sock" "$HOME/.local/bin/herdr" \
            status server --json 2>/dev/null | jq -r '.compatible')
          if [ "$compat" = "false" ]; then printf '  %s\n' "$name"; fi
        done
  ) || true
  if [ -n "$stale" ]; then
    echo "herdr-fork-update: these servers still run the previous build:"
    echo "$stale"
    echo '  local panes keep working; `herdr --remote` will refuse to attach.'
    echo "  clear each with: herdr --session <name> server stop"
  fi
fi
