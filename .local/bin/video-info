#!/usr/bin/env bash
#
# video-info — print video metadata as key=value lines (via ffprobe).
#
# Usage: video-info <video-file>

set -euo pipefail

usage() {
    cat <<'EOF'
video-info — print video metadata as key=value lines (via ffprobe).

Reports: width, height, r_frame_rate, avg_frame_rate, frame count, duration.

Usage: video-info <video-file>
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi
if [[ ! -f "$1" ]]; then
    echo "video-info: file not found: $1" >&2
    exit 2
fi

ffprobe -v error -select_streams v:0 -count_packets \
    -show_entries stream=width,height,r_frame_rate,avg_frame_rate,nb_read_packets,duration \
    -of default=noprint_wrappers=1 "$1"
