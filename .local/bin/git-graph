#!/bin/bash
# git-graph — a live hunk pane with serie's graph as a strip below, hunk
# following the graph cursor (also `git graph`). herdr popups cannot be
# split and hunk needs a real tty, so the layout is panes, synced by
# hunk's session daemon re-pointing a live pane.
#
#   git-graph            hunk on HEAD in this pane, serie underneath
#   git-graph --send <h> load commit <h> into the hunk pane (serie's v);
#                        the WIP row's zero hash loads the working tree
set -euo pipefail

# Serie's v and i run inside the layout, where serie-follow's exported
# pane id pins the session — without it a second hunk on the repo (a gi
# pane) makes --repo . ambiguous. Standalone falls back to --repo ..
resolve_target() {
  target=(--repo .)
  [ -n "${SERIE_FOLLOW_HUNK_PANE:-}" ] || return 0
  local pids sid
  pids=$(herdr pane process-info --pane "$SERIE_FOLLOW_HUNK_PANE" 2>/dev/null \
    | jq -c '[.result.process_info.foreground_processes[].pid]') || return 0
  sid=$(hunk session list --json 2>/dev/null \
    | jq -r --argjson pids "${pids:-[]}" \
        '.sessions[] | select(.pid as $p | $pids | index($p)) | .sessionId' \
    | head -1)
  [ -n "$sid" ] && target=("$sid")
  return 0
}

if [ "${1:-}" = "--send" ]; then
  # Serie runs this silent: drop the success stdout; a failure exits 1
  # and lands in serie's status line.
  [ -n "${2:-}" ] || { echo "git-graph: --send needs a commit hash" >&2; exit 1; }
  resolve_target
  case $2 in
    0000000*) exec hunk session reload "${target[@]}" -- diff > /dev/null ;;
    *)        exec hunk session reload "${target[@]}" -- show "$2" > /dev/null ;;
  esac
fi

for cmd in hunk serie jq serie-follow; do
  command -v "$cmd" > /dev/null 2>&1 || {
    echo "git-graph: $cmd not found — brew install it first." >&2; exit 1; }
done
[ -n "${HERDR_PANE_ID:-}" ] || {
  echo "git-graph: not inside a herdr pane — the layout needs herdr splits." >&2
  exit 1
}
git rev-parse --is-inside-work-tree > /dev/null

# --ratio is the current pane's share: hunk keeps 75% at full width,
# enough for its side-by-side layout. --focus lands you in serie.
pane_id=$(herdr pane split --current --direction down --ratio 0.75 \
    --cwd "$PWD" --focus | jq -r '.result.pane.pane_id')
[ -n "$pane_id" ] && [ "$pane_id" != "null" ] || {
  echo "git-graph: herdr pane split returned no pane id" >&2; exit 1; }

# SERIE_FOLLOW_HUNK_PANE pins the follower to this pane's hunk session,
# so a second hunk on the repo cannot make its reloads ambiguous.
herdr pane run "$pane_id" \
    "SERIE_FOLLOW_HUNK_PANE=$HERDR_PANE_ID serie-follow; git-graph --teardown $HERDR_PANE_ID $pane_id" > /dev/null

exec zsh -lc 'hunk show HEAD'
