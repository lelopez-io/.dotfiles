#!/bin/bash
# agent-profile — print the 1Password profile for agent $1 in this directory.
# Resolution order (first match wins):
#   1. git config agent.<name>.profile   (agent-specific, per-repo/org includeIf)
#   2. git config agent.profile          (context profile for ALL agents)
#   3. ~/.config/agent-profiles/<name>   (machine-local default)
# Empty output = no profile; callers decide what "bare" means for their agent.
# Profile names are contexts, not keys: each wrapper resolves its own item
# ("pi | <profile>", "cld | <profile>") which carries its own env_var.
set -euo pipefail
agent="${1:?usage: agent-profile <name>}"
profile=$(git config --get "agent.$agent.profile" 2>/dev/null || true)
[ -z "$profile" ] && profile=$(git config --get agent.profile 2>/dev/null || true)
if [ -z "$profile" ]; then
  f="$HOME/.config/agent-profiles/$agent"
  [ -f "$f" ] && read -r profile < "$f" || true
fi
printf '%s' "${profile:-}"
