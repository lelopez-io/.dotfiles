{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/.local/bin/agent-session-mark\" --hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(tree:*)",
      "Bash(xargs cat:*)",
      "Bash(flutter:*)",
      "Bash(mise trust:*)",
      "Bash(obsidian:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(go fmt:*)",
      "Bash(go test:*)",
      "Bash(go tool cover:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(rio help:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn jest:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn start:*)",
      "Bash(yarn test:*)",
      "Bash(yarn typecheck)",
      "Bash(gt checkout:*)",
      "WebFetch(domain:docs.turso.tech)",
      "WebFetch(domain:fnox.jdx.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:turso.tech)",
      "WebFetch(domain:tursodatabase.github.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git -C:*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
