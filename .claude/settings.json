{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(tree:*)",
      "Bash(xargs cat:*)",
      "Bash(flutter:*)",
      "Bash(mise trust:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(go fmt:*)",
      "Bash(go test:*)",
      "Bash(go tool cover:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(rio help:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn jest:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn start:*)",
      "Bash(yarn test:*)",
      "Bash(yarn typecheck)",
      "Bash(gt checkout:*)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(git -C:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'beep 3'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'beep 3'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '$HOME/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '$HOME/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
