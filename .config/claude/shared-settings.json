{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(tree:*)",
      "Bash(xargs cat:*)",
      "Bash(flutter:*)",
      "Bash(mise trust:*)",
      "Bash(obsidian:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(go fmt:*)",
      "Bash(go test:*)",
      "Bash(go tool cover:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(rio help:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn jest:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn start:*)",
      "Bash(yarn test:*)",
      "Bash(yarn typecheck:*)",
      "Bash(gt checkout:*)",
      "WebFetch(domain:docs.turso.tech)",
      "WebFetch(domain:fnox.jdx.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:turso.tech)",
      "WebFetch(domain:tursodatabase.github.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git -C:*)",
      "Read(~/.config/op/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/agent-argv-guard\" --selftest >/dev/null 2>&1 || echo 'WARNING: agent-argv-guard selftest failed. The secret guard fails open, so it is not enforcing until repaired.'" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "$HOME/.config/claude/hooks/pretooluse-argv-guard.sh" }
        ]
      }
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
