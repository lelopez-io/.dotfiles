## [REQUIRED] Essential
brew "eza"
brew "fzf"                     # fuzzy finder, gco + keybindings in dotfiles
brew "git-delta"               # diff pager, used by 02-dotfiles.sh and 05-git.sh
brew "jq"                      # git-graph, herdr-fork-update
brew "libyaml"                 # ruby build dependency (mise)
brew "mise"
brew "starship"
brew "stow"
brew "herdr"                  # terminal workspace manager, the daily driver
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
cask "font-anonymice-nerd-font"  # ghostty font-family names this exactly
cask "ghostty"

## [REQUIRED] Neovim
brew "neovim"
brew "imagemagick"        # image.nvim
brew "mermaid-cli"        # mermaid diagram rendering
brew "prettierd"          # conform.nvim formatter
brew "ripgrep"            # telescope.nvim live_grep
brew "stylua"             # conform.nvim formatter
brew "tree-sitter-cli"    # nvim-treesitter parser compilation
cask "ungoogled-chromium" # mermaid-cli puppeteer backend

## [REQUIRED] Git review
brew "modem-dev/tap/hunk"  # git-graph and git-inspect wrap it
brew "serie"               # git-graph's graph strip; 06-forks shadows it

## [OPTIONAL] CLI Tools
brew "pv"                 # pipe progress meter, used by verify-copy
brew "shellcheck"         # lints ~/.local/bin scripts
brew "the_silver_searcher"
brew "tree"
# brew "atuin"             # shell history w/ sync, evaluate
# brew "telnet"
# brew "tmux"              # herdr replaced it; fallback multiplexer
# brew "watch"
# brew "wget"
# brew "yamllint"
# brew "yq"

## [OPTIONAL] Git & GitHub
brew "git-town"  # stacked PR workflow, cross-platform (GitHub, Forgejo, Codeberg)
brew "lazygit"   # git TUI for SSH/headless sessions
brew "gh"        # @account-required; extensions managed in 05-git.sh
cask "gitkraken"  # @account-required

## [OPTIONAL] Editors & IDEs
cask "zed"
# cask "android-studio"
# cask "visual-studio-code"
# cask "postman"  # @account-required

## [OPTIONAL] AI Tools
cask "claude-code"  # @account-required

## [OPTIONAL] Cloud & Infrastructure
brew "ansible"
brew "hashicorp/tap/terraform"
brew "awscli"  # @account-required
cask "gcloud-cli"  # @account-required

## [OPTIONAL] Containers
brew "colima"  # dockerd in a lima VM: no GUI, and no Kubernetes unless asked
brew "docker"
brew "docker-buildx"
brew "docker-compose"

## [OPTIONAL] Kubernetes
brew "fluxcd/tap/flux"
brew "helm"
brew "kubectx"
brew "kubernetes-cli"
brew "talhelper"

## [OPTIONAL] Secrets & Auth
brew "age"
brew "gnupg"
brew "sops"
cask "1password"  # @account-required
cask "1password-cli"  # @account-required

## [OPTIONAL] Browsers
