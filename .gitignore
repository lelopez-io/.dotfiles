# macOS
.DS_Store

# vscode generated files
.vscode/extensions
.vscode/argv.json

# local env files
.env
.env*.prod
.env*.local
.env*.aider

# zsh local (user-specific) overrides — never committed
.zshrc.local

# mise local (user-specific) overrides — never committed
mise.local.toml
.mise.local.toml
mise.*.local.toml
.mise.*.local.toml

# aider
.aider*

# claude
.claude/*
!.claude/settings.json

# Setup generated state
.setup/Brewfile.*.lock.json

# Keep nvim plugin versions in git
!.config/nvim/lazy-lock.json

**/.claude/settings.local.json
