# macOS
.DS_Store

# vscode generated files
.vscode/extensions
.vscode/argv.json

# local env files
.env
.env*.prod
.env*.local
.env*.aider

# zsh local (user-specific) overrides — never committed
.zshrc.local

# mise local (user-specific) overrides — never committed
mise.local.toml
.mise.local.toml
mise.*.local.toml
.mise.*.local.toml

# aider
.aider*

# claude
.claude/*

# pi runtime state (auth, trust, model store, sessions); the shared pieces are
# the extensions and the global rules file. --no-folding keeps ~/.pi real, so
# this is the backstop for a stow run by hand without it.
.pi/*
!.pi/agent/
.pi/agent/*
!.pi/agent/extensions/
!.pi/agent/AGENTS.md

# Setup generated state
.setup/Brewfile.*.lock.json

# herdr runtime state (sockets, session, logs) — only config.toml is shared.
# Guards the case where stow folds ~/.config/herdr into a dir symlink on a
# fresh machine; 02-dotfiles.sh passes --no-folding to prevent that.
.config/herdr/*
!.config/herdr/config.toml

# Keep nvim plugin versions in git
!.config/nvim/lazy-lock.json

**/.claude/settings.local.json

# rio per-repo workspace state
.rio/
