# sops — see sopsx (run sops with the repo age key) + sopse (encrypt to its
# public key) in ~/.local/bin

# git
# gg walks commits beside serie's graph, gr reads the branch as its PR,
# gi watches what isn't committed yet; quick glances are the herdr popups
alias gg='git-graph'
alias gi='git-inspect'
alias gr='git-review'

alias hs='herdr --session'

# neovim
alias vim='nvim'
alias dot='cd $HOME/.dotfiles/. && nvim . && cd -'

# obs opens the vault ~/.zshrc.local names, the one obsidian.nvim uses.
alias obs='cd "${OBSIDIAN_VAULT:?set it in ~/.zshrc.local}" && nvim . && cd -'

# directory/navigation
alias ls='eza --group-directories-first --icons'
alias lh='eza --group-directories-first --icons --almost-all'
alias ll='eza --group-directories-first --icons --long'
alias la='eza --group-directories-first --icons --long --almost-all'
alias lt='tree -LFC 2 --dirsfirst'

# kubernetes
alias k='kubectl'
alias ka='k get deploy,rs,po,svc,ep'
alias kd='k --dry-run=client -o yaml'
alias kc='kubectx'
alias kn='kubens'
alias ko='kc -u'

# docker
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}" | sed -e "s/k8s_[^_]*_//g" -e "s/_kube-system[^[:space:]]*//" | column -t'

# yt-dlp
alias ytf='yt-dlp -F --extractor-args youtube:player_client=default,ios --verbose'
alias ttf='yt-dlp -F --verbose'
