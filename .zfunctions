# Shell functions — helpers that must mutate the *current* shell (an export
# or eval that must persist for the session; as scripts they'd be no-ops).
# Per-project env belongs in that repo's mise.toml [env] section, not here.
# Self-contained programs live in ~/.local/bin/.
#
# Secrets never persist here by design: sopsx/opx/cld/pie resolve them
# per-invocation into a child's env only.

# Biometric unlock misbehaves in some terminal contexts — disable before signin.
# OP_SESSION_* is the one sanctioned session-persistent credential; never
# launch an agent from a shell that has it (cld/pie strip it as a backstop).
opsignin() {
    export OP_BIOMETRIC_UNLOCK_ENABLED=false
    local session
    session=$(op signin) || { echo "opsignin: op signin failed" >&2; return 1; }
    eval "$session"
    echo "1Password CLI session loaded (biometric unlock disabled)"
}

# No-arg picks via fzf so the profile name never enters shell history.
awsprof() {
    local profile=${1:-}
    if [[ -z "$profile" ]]; then
        profile=$(aws configure list-profiles | fzf --prompt='AWS_PROFILE> ') || return 0
        [[ -n "$profile" ]] || return 0
    fi
    export AWS_PROFILE="$profile"
    echo "AWS_PROFILE=$AWS_PROFILE"
}
